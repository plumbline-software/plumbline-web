# Resend (https://resend.com) transactional email — used by the /contact form.
# Copy this file to .env and fill in real values. .env is gitignored.

# API key from the Resend dashboard.
RESEND_API_KEY=

# Sender address. Optional — defaults to Resend's shared test sender
# (onboarding@resend.dev), which only delivers to the account owner's own
# email. Once Plumbline has a domain verified in Resend, set this to an
# address on that domain instead, e.g. "Plumbline Software <hello@your-domain.com>".
RESEND_FROM_EMAIL=

# Where contact-form submissions get delivered. Optional — defaults to
# plumbline.software@gmail.com.
RESEND_TO_EMAIL=

# --- Search engines (optional) ---------------------------------------------
# Google Search Console → Add property → URL prefix → "HTML tag" method.
# Paste only the content="..." value, e.g. abc123XYZ.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → Add site → "HTML Meta Tag" method (or import from Google instead).
PUBLIC_BING_SITE_VERIFICATION=

# Canonical site address. Optional — on Vercel this defaults to the project's production
# URL (e.g. https://plumbline-software.vercel.app). Set it once a custom domain exists.
SITE_URL=
