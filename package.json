{
  "name": "plumbline-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun run build:studio && astro dev",
    "build": "bun run build:studio && astro build",
    "build:studio": "cd studio-plumbline-software && bun install --frozen-lockfile && SANITY_STUDIO_BASEPATH=/admin bunx sanity build ../public/admin --yes",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.14",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.2",
    "astro-portabletext": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "groq": "^6.19.0",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9"
  }
}
