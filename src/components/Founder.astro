---
import { FOUNDER } from '../data';

const links = [
	{ label: 'LinkedIn', href: FOUNDER.linkedin },
	{ label: 'GitHub', href: FOUNDER.github },
].filter((link) => link.href);
---

<section id="founder" aria-labelledby="founder-heading" class="mx-auto max-w-7xl scroll-mt-24 px-4 pb-20 sm:px-6 sm:pb-24 lg:px-8">
	<h2 id="founder-heading" class="display border-t border-ink pt-5 text-[clamp(2.5rem,6vw,4rem)]">Who you'll work with</h2>
	<div class="mt-10 grid gap-8 lg:grid-cols-12 lg:gap-10">
		<div class="lg:col-span-5">
			<div>
				<div>
					<h3 class="display text-5xl">{FOUNDER.name}</h3>
					<p class="mt-2 text-ink-2">{FOUNDER.title}, Northline Technologies</p>
					{
						links.length > 0 && (
							<ul class="mt-4 flex gap-5 text-sm">
								{links.map((link) => (
									<li><a href={link.href} rel="me noopener" target="_blank" class="link">{link.label}</a></li>
								))}
							</ul>
						)
					}
				</div>
			</div>
		</div>
		<div class="lg:col-span-7">
			<p class="text-xl font-medium leading-relaxed text-ink">{FOUNDER.why}</p>
			<h4 class="mt-10 font-semibold text-ink">Before Northline</h4>
			<ul class="mt-3 border-t border-rule">
				{
					FOUNDER.experience.map((item) => (
						<li class="flex items-start gap-3.5 border-b border-rule py-3 text-ink-2">
							<svg viewBox="0 0 16 16" class="mt-1 h-4 w-4 shrink-0 text-ink" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m3 8.5 3 3 7-7" /></svg>
							{item}
						</li>
					))
				}
			</ul>
			<p class="mt-4 text-xs text-muted">Past employment is listed as personal experience. Northline has no affiliation with Samsung.</p>
		</div>
	</div>
</section>
