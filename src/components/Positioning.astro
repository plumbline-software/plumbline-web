---
import SectionHeading from './SectionHeading.astro';

const pillars = [
	{
		title: 'Product Engineering',
		copy: "We start from the workflow or problem you're trying to solve, not a template.",
		detail: 'Every screen and every API exists because something in your business actually needs it — not because it looked good in a wireframe.',
	},
	{
		title: 'Technical Excellence',
		copy: "Code that's tested, typed, and documented well enough for someone else to pick up.",
		detail: "We'd rather spend an extra day getting it right now than leave you something that only makes sense to the person who wrote it.",
	},
	{
		title: 'Reliable Delivery',
		copy: "You'll know what's being built, when, and why, at every stage.",
		detail: 'No disappearing for six weeks and re-emerging with something unrecognizable. Progress is visible, and scope changes are a conversation, not a surprise.',
	},
];
---

<section aria-labelledby="positioning-heading" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
	<SectionHeading
		id="positioning-heading"
		heading="Engineering built around the problem."
		copy="From customer-facing applications to internal platforms and APIs, we focus on building software that's useful, maintainable, and ready to evolve — rather than software that just works on launch day."
	/>
	<div class="mt-14 grid border-t border-rule md:grid-cols-3">
		{
			pillars.map((pillar) => (
				<div class="border-b border-rule py-7 md:border-b-0 md:border-l md:px-7 md:py-2 md:first:border-l-0 md:first:pl-0">
					<h3 class="display text-2xl">{pillar.title}</h3>
					<p class="mt-3 leading-relaxed text-ink">{pillar.copy}</p>
					<p class="mt-3 leading-relaxed text-ink-2">{pillar.detail}</p>
				</div>
			))
		}
	</div>
</section>
