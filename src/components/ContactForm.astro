---
import { SITE, services, timelines } from '../data';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Textarea } from '@/components/ui/textarea';
import SelectField from './SelectField';
import Flow from './Flow.astro';
import { Send, Reply, PhoneCall } from 'lucide-react';

// TODO(owner): review these answers — they describe how Plumbline works, so they must stay true.
const faqs = [
	{
		q: 'Can you work on an existing codebase?',
		a: 'Yes. Plenty of useful work starts with reading what is already there, stabilising it, and extending it rather than rewriting it.',
	},
	{
		q: 'Do you only build, or can you advise?',
		a: 'Both. Technology consulting stands on its own — a second opinion on an architecture or vendor decision, whether or not we build anything afterwards.',
	},
	{
		q: 'Who owns the code?',
		a: 'You do. Code, infrastructure definitions, and documentation are handed over so your team can carry on without us.',
	},
	{
		q: 'Where are you based?',
		a: `${SITE.location}, on Pacific Time.`,
	},
];
---

<section aria-labelledby="contact-heading" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
	<div class="grid gap-5 border-b border-ink pb-10 lg:grid-cols-12 lg:gap-10 lg:pb-14">
		<h1 id="contact-heading" class="display text-[clamp(3.5rem,11vw,6rem)] lg:col-span-7">
			Start a conversation.
		</h1>
		<p class="max-w-xl text-lg leading-relaxed text-ink-2 lg:col-span-5 lg:self-end">
			Tell us what you're trying to build, improve, or solve. You don't need a spec — rough is fine.
		</p>
	</div>
	<Flow
		class="mt-10"
		steps={[
			{
				icon: Send,
				title: 'You send a note',
				note: 'What you are building or fixing, and roughly when. A few sentences is plenty.',
			},
			{
				icon: Reply,
				title: 'The founder replies',
				note: `Personally, within ${SITE.replyTime}, with questions or a time to talk. No sales handoff.`,
			},
			{
				icon: PhoneCall,
				title: 'A short call',
				note: 'Talk the problem through and leave with an honest view of what it would take.',
			},
		]}
		caption="These steps come before stage 1 of how an engagement runs."
	/>
	<div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-10">
		<div class="lg:col-span-7">
			<form
				id="contact-form"
				class="bg-paper-2 p-6 sm:p-10"
				novalidate
				data-email={SITE.email}
				data-reply={SITE.replyTime}
			>
				<p class="mb-6 text-sm text-ink-2">All fields are required unless marked optional.</p>
				<div class="hidden" aria-hidden="true">
					<label for="website">Website</label>
					<input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
				</div>

				<div class="grid gap-6 sm:grid-cols-2">
					<div>
						<Label htmlFor="name">Name</Label>
						<Input type="text" id="name" name="name" required autoComplete="name" maxLength={200} className="mt-2" />
						<p id="name-error" class="mt-1.5 text-sm font-medium text-error" hidden></p>
					</div>
					<div>
						<Label htmlFor="email">Email</Label>
						<Input
							type="email"
							id="email"
							name="email"
							required
							autoComplete="email"
							maxLength={200}
							className="mt-2"
						/>
						<p id="email-error" class="mt-1.5 text-sm font-medium text-error" hidden></p>
					</div>
					<div class="sm:col-span-2">
						<Label htmlFor="organization">
							Organization <span class="font-normal text-muted-foreground">(optional)</span>
						</Label>
						<Input
							type="text"
							id="organization"
							name="organization"
							autoComplete="organization"
							maxLength={200}
							className="mt-2"
						/>
					</div>
					<div>
						<Label htmlFor="service">What do you need?</Label>
						<SelectField
							id="service"
							name="service"
							className="mt-2"
							options={[
								{ value: '', label: 'Not sure yet' },
								...services.map((s) => ({ value: s.slug, label: s.name })),
							]}
						/>
					</div>
					<div>
						<Label htmlFor="timeline">Timeline</Label>
						<SelectField
							id="timeline"
							name="timeline"
							className="mt-2"
							options={[{ value: '', label: 'No fixed date' }, ...timelines.map((t) => ({ value: t, label: t }))]}
						/>
					</div>
					<div class="sm:col-span-2">
						<Label htmlFor="message">Project details</Label>
						<Textarea
							id="message"
							maxLength={5000}
							name="message"
							required
							rows={6}
							placeholder="What are you building, what stage is it at, and what's getting in the way?"
							className="mt-2"
						/>
						<p id="message-error" class="mt-1.5 text-sm font-medium text-error" hidden></p>
					</div>
				</div>

				<div class="mt-8">
					<p id="contact-form-status" class="mb-4 text-sm" role="status" aria-live="polite" hidden></p>
					<Button type="submit" className="w-full">
						Send message
					</Button>
					<p class="mt-3 text-center text-xs text-muted-foreground">
						Your details are only used to reply to you.{' '}
						<a href="/privacy" class="link">
							Privacy
						</a>
					</p>
				</div>
			</form>

			<div id="contact-success" class="border border-ink p-6 sm:p-10" hidden>
				<h2 class="display text-5xl" tabindex="-1">
					Message sent.
				</h2>
				<p class="mt-4 text-lg leading-relaxed text-ink">
					Thanks, <span data-out="name"></span>. You'll get a personal reply at{' '}
					<span data-out="email" class="font-semibold"></span> within <span data-out="reply"></span>.
				</p>
				<p class="mt-4 leading-relaxed text-ink-2">
					While you wait, see{' '}
					<a href="/approach" class="link text-ink">
						how an engagement runs
					</a>
					.
				</p>
				<Button type="button" id="contact-again" variant="outline" className="mt-8">
					Send another message
				</Button>
			</div>
		</div>

		<aside class="lg:col-span-5">
			<p class="text-sm text-ink-2">
				Prefer email?{' '}
				<a href={`mailto:${SITE.email}`} class="link text-ink">
					{SITE.email}
				</a>
			</p>

			<h2 class="mt-12 border-b border-ink pb-3 font-semibold">Common questions</h2>
			<div class="divide-y divide-rule border-b border-rule">
				{faqs.map((faq) => (
					<details class="group py-4">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">
							{faq.q}
							<svg
								viewBox="0 0 16 16"
								class="h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								aria-hidden="true"
							>
								<path d="m3 6 5 5 5-5" />
							</svg>
						</summary>
						<p class="mt-2 text-sm leading-relaxed text-ink-2">{faq.a}</p>
					</details>
				))}
			</div>
		</aside>
	</div>
</section>

<script is:inline>
	(() => {
		const form = document.getElementById('contact-form');
		const status = document.getElementById('contact-form-status');
		const success = document.getElementById('contact-success');
		if (!(form instanceof HTMLFormElement) || !status || !success) return;
		const { email: inbox, reply } = form.dataset;

		// Links like /contact?service=frontend preselect the service.
		const service = new URLSearchParams(location.search).get('service');
		const select = form.elements.namedItem('service');
		if (service && select instanceof HTMLSelectElement && [...select.options].some((o) => o.value === service)) {
			select.value = service;
		}

		const checks = {
			name: (v) => (v ? '' : 'Enter your name.'),
			email: (v, el) =>
				!v
					? 'Enter your email address.'
					: el.validity.typeMismatch
						? 'Enter an email address like name@company.com.'
						: '',
			message: (v) => (v ? '' : 'Tell us a little about the project. A few sentences is enough.'),
		};

		const setError = (id, message) => {
			const field = form.elements.namedItem(id);
			const note = document.getElementById(`${id}-error`);
			if (!(field instanceof HTMLElement) || !note) return;
			note.textContent = message;
			note.hidden = !message;
			if (message) {
				field.setAttribute('aria-invalid', 'true');
				field.setAttribute('aria-describedby', note.id);
			} else {
				field.removeAttribute('aria-invalid');
				field.removeAttribute('aria-describedby');
			}
		};

		// Clear a field's error as soon as it's fixed.
		for (const id of Object.keys(checks)) {
			const field = form.elements.namedItem(id);
			field?.addEventListener('input', () => {
				if (field.getAttribute('aria-invalid') && !checks[id](field.value.trim(), field)) setError(id, '');
			});
		}

		const showStatus = (text, tone, withEmail = false) => {
			status.hidden = false;
			status.replaceChildren(text);
			if (withEmail) {
				const link = document.createElement('a');
				link.href = `mailto:${inbox}`;
				link.className = 'link';
				link.textContent = inbox;
				status.append(link, '.');
			}
			status.className =
				tone === 'error' ? 'mb-4 border border-error px-3 py-2 text-sm text-error' : 'mb-4 text-sm text-ink-2';
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			let firstInvalid = null;
			for (const [id, check] of Object.entries(checks)) {
				const field = form.elements.namedItem(id);
				const message = check(field.value.trim(), field);
				setError(id, message);
				if (message && !firstInvalid) firstInvalid = field;
			}
			if (firstInvalid) {
				status.hidden = true;
				firstInvalid.focus();
				return;
			}

			const submitButton = form.querySelector('button[type="submit"]');
			const data = Object.fromEntries(new FormData(form).entries());
			showStatus('Sending…', 'info');
			submitButton.disabled = true;
			submitButton.textContent = 'Sending…';

			try {
				const response = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});
				const result = await response.json().catch(() => ({}));

				if (result.ok) {
					for (const el of success.querySelectorAll('[data-out]')) {
						el.textContent = { name: data.name, email: data.email, reply }[el.dataset.out] ?? '';
					}
					form.hidden = true;
					status.hidden = true;
					success.hidden = false;
					success.querySelector('h2').focus();
					form.reset();
				} else if (response.status < 500 && result.error) {
					showStatus(result.error, 'error');
				} else {
					showStatus(
						"The form couldn't send your message. Nothing you typed is lost: copy it and email ",
						'error',
						true,
					);
				}
			} catch {
				showStatus(
					'Your connection dropped before the message sent. Nothing you typed is lost: try again, or email ',
					'error',
					true,
				);
			} finally {
				submitButton.disabled = false;
				submitButton.textContent = 'Send message';
			}
		});

		document.getElementById('contact-again')?.addEventListener('click', () => {
			success.hidden = true;
			form.hidden = false;
			form.elements.namedItem('name')?.focus();
		});
	})();
</script>
