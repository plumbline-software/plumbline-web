---
import { SITE, FOUNDER, services, timelines } from '../data';

const nextSteps = [
	{ title: 'You send a short note', copy: 'What you are building or fixing, and roughly when. A few sentences is plenty.' },
	{ title: `${FOUNDER.firstName} replies personally`, copy: `Within ${SITE.replyTime}, with questions or a time to talk. No sales handoff.` },
	{ title: 'A short call to scope it', copy: 'We talk through the problem and you leave with an honest view of what it would take.' },
];

// TODO(owner): review these answers — they describe how Northline works, so they must stay true.
const faqs = [
	{
		q: 'Can you work on an existing codebase?',
		a: 'Yes. Plenty of useful work starts with reading what is already there, stabilising it, and extending it rather than rewriting it.',
	},
	{
		q: 'Do you only build, or can you advise?',
		a: 'Both. Technology consulting stands on its own — a second opinion on an architecture or vendor decision, whether or not we build anything afterwards.',
	},
	{
		q: 'Who owns the code?',
		a: 'You do. Code, infrastructure definitions, and documentation are handed over so your team can carry on without us.',
	},
	{
		q: 'Where are you based?',
		a: `${SITE.location}, on Pacific Time.`,
	},
];

const field =
	'mt-2 block w-full border border-field bg-paper px-3.5 py-3 text-ink placeholder:text-muted hover:border-ink focus-visible:border-ink focus-visible:outline-offset-0';
---

<section aria-labelledby="contact-heading" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
	<div class="grid gap-5 border-b border-ink pb-10 lg:grid-cols-12 lg:gap-10 lg:pb-14">
		<h1 id="contact-heading" class="display text-[clamp(3.5rem,11vw,6rem)] lg:col-span-7">Have a project in mind?</h1>
		<p class="max-w-xl text-lg leading-relaxed text-ink-2 lg:col-span-5 lg:self-end">
			Tell us what you're trying to build, improve, or solve. You don't need a spec — rough is fine.
		</p>
	</div>
	<div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-10">
		<div class="lg:col-span-7">
			<form id="contact-form" class="bg-paper-2 p-6 sm:p-10" novalidate>
				<div class="hidden" aria-hidden="true">
					<label for="website">Website</label>
					<input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
				</div>

				<div class="grid gap-6 sm:grid-cols-2">
					<div>
						<label for="name" class="block text-sm font-semibold">Name</label>
						<input type="text" id="name" name="name" required autocomplete="name" class={field} />
					</div>
					<div>
						<label for="email" class="block text-sm font-semibold">Work email</label>
						<input type="email" id="email" name="email" required autocomplete="email" class={field} />
					</div>
					<div class="sm:col-span-2">
						<label for="organization" class="block text-sm font-semibold">
							Organization <span class="font-normal text-muted">(optional)</span>
						</label>
						<input type="text" id="organization" name="organization" autocomplete="organization" class={field} />
					</div>
					<div>
						<label for="service" class="block text-sm font-semibold">What do you need?</label>
						<select id="service" name="service" class={field}>
							<option value="">Not sure yet</option>
							{services.map((s) => <option value={s.slug}>{s.name}</option>)}
						</select>
					</div>
					<div>
						<label for="timeline" class="block text-sm font-semibold">Timeline</label>
						<select id="timeline" name="timeline" class={field}>
							<option value="">No fixed date</option>
							{timelines.map((t) => <option>{t}</option>)}
						</select>
					</div>
					<div class="sm:col-span-2">
						<label for="message" class="block text-sm font-semibold">Project details</label>
						<textarea
							id="message"
							name="message"
							required
							rows="6"
							placeholder="What are you building, what stage is it at, and what's getting in the way?"
							class={field}
						></textarea>
					</div>
				</div>

				<div class="mt-8">
					<p id="contact-form-status" class="mb-4 text-sm" role="status" aria-live="polite" hidden></p>
					<button type="submit" class="btn btn-ink w-full disabled:pointer-events-none disabled:opacity-60">Send message</button>
					<p class="mt-3 text-center text-xs text-muted">Your details are only used to reply to you.</p>
				</div>
			</form>
		</div>

		<aside class="lg:col-span-5">
			<h2 class="border-b border-ink pb-3 font-semibold">What happens next</h2>
			<ol class="relative mt-6 space-y-7 pl-12">
				<span class="absolute bottom-1 left-[0.95rem] top-1 w-0.5 bg-ink" aria-hidden="true"></span>
				{
					nextSteps.map((step, i) => (
						<li class="relative">
							<span class="absolute -left-12 top-0 flex h-8 w-8 items-center justify-center border border-ink bg-paper font-display text-base font-semibold" aria-hidden="true">
								{i + 1}
							</span>
							<p class="font-semibold text-ink">{step.title}</p>
							<p class="mt-1 text-sm leading-relaxed text-ink-2">{step.copy}</p>
						</li>
					))
				}
			</ol>

			<p class="mt-10 text-sm text-ink-2">
				Prefer email? <a href={`mailto:${SITE.email}`} class="link text-ink">{SITE.email}</a>
			</p>

			<h2 class="mt-12 border-b border-ink pb-3 font-semibold">Common questions</h2>
			<div class="divide-y divide-rule border-b border-rule">
				{
					faqs.map((faq) => (
						<details class="group py-4">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">
								{faq.q}
								<svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M8 2v12M2 8h12" />
								</svg>
							</summary>
							<p class="mt-2 text-sm leading-relaxed text-ink-2">{faq.a}</p>
						</details>
					))
				}
			</div>
		</aside>
	</div>
</section>

<script is:inline>
	(() => {
		const form = document.getElementById('contact-form');
		const status = document.getElementById('contact-form-status');
		if (!(form instanceof HTMLFormElement) || !status) return;

		// Links like /contact?service=frontend preselect the service.
		const service = new URLSearchParams(location.search).get('service');
		const select = form.elements.namedItem('service');
		if (service && select instanceof HTMLSelectElement && [...select.options].some((o) => o.value === service)) {
			select.value = service;
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const submitButton = form.querySelector('button[type="submit"]');
			const data = Object.fromEntries(new FormData(form).entries());

			status.hidden = false;
			status.textContent = 'Sending…';
			status.className = 'mb-4 text-sm text-ink-2';
			if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;

			try {
				const response = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});
				const result = await response.json();

				if (result.ok) {
					form.reset();
					status.textContent = 'Message sent. You will get a reply at the email you gave.';
					status.className = 'mb-4 border border-ink px-3 py-2 text-sm font-semibold text-ink';
				} else {
					status.textContent = result.error || 'The message could not be sent. Try again, or email us directly.';
					status.className = 'mb-4 border border-red-700 px-3 py-2 text-sm text-red-700';
				}
			} catch {
				status.textContent = 'The message could not be sent. Check your connection and try again, or email us directly.';
				status.className = 'mb-4 border border-red-700 px-3 py-2 text-sm text-red-700';
			} finally {
				if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
			}
		});
	})();
</script>
