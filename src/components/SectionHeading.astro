---
interface Props {
	id: string;
	heading: string;
	copy?: string;
	/** h1 when the section opens its own page — rendered larger, as the page title. */
	as?: 'h1' | 'h2';
}

const { id, heading, copy, as: Tag = 'h2' } = Astro.props;
const isPage = Tag === 'h1';
---

<div class:list={['grid gap-5 lg:grid-cols-12 lg:gap-10', isPage ? 'border-b border-ink pb-10 sm:pb-14' : 'border-t border-ink pt-5']}>
	<Tag
		id={id}
		class:list={['display text-ink lg:col-span-7', isPage ? 'text-[clamp(3.5rem,11vw,6rem)]' : 'text-[clamp(2.5rem,6vw,4rem)]']}
	>
		{heading}
	</Tag>
	{copy && <p class="max-w-xl text-lg leading-relaxed text-ink-2 lg:col-span-5 lg:self-end">{copy}</p>}
</div>
