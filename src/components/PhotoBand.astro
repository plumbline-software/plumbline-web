---
// A full-width photograph band (black and white, to match the palette) with its credit.
// The image's hotspot, set in Sanity, keeps the subject in frame when the band crops it.
import { imageSize, urlFor } from '@/lib/sanity';

interface Props {
	photo: any;
}

const { photo } = Astro.props;
const { width, height } = imageSize(photo);
const position = photo.hotspot ? `${photo.hotspot.x * 100}% ${photo.hotspot.y * 100}%` : 'center';
---

<figure class="m-0 border-y border-ink">
	<img
		src={urlFor(photo).width(2000).url()}
		srcset={`${urlFor(photo).width(1000).url()} 1000w, ${urlFor(photo).width(2000).url()} 2000w`}
		sizes="100vw"
		width={width}
		height={height}
		alt={photo.alt}
		loading="lazy"
		decoding="async"
		class="block h-[42vh] max-h-[560px] min-h-64 w-full object-cover sm:h-[55vh]"
		style={`object-position: ${position}`}
	/>
	<figcaption class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-3 text-sm text-ink-2 sm:flex-row sm:justify-between sm:px-6 lg:px-8">
		<span>{photo.caption}</span>
		{photo.creditName && (
			<span class="text-xs text-muted-foreground">
				Photo:{' '}
				<a href={photo.creditUrl} class="link" rel="noopener" target="_blank">
					{photo.creditName}
				</a>
				{photo.creditUrl?.includes('unsplash.com') && ' on Unsplash'}
			</span>
		)}
	</figcaption>
</figure>
