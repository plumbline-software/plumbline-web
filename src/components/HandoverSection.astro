---
import SectionHeading from './SectionHeading.astro';
import HandoverPack from './HandoverPack.astro';
import RichText from './RichText.astro';

interface Props {
	heading: string;
	copy: string;
	pack: any;
	points: { title: string; body?: any[] }[];
}

const { heading, copy, pack, points } = Astro.props;
---

<section aria-labelledby="handover-heading" class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 sm:pb-24 lg:px-8">
	<SectionHeading id="handover-heading" {heading} {copy} />
	<div class="mt-12 grid gap-10 lg:grid-cols-12 lg:items-center">
		<div class="lg:col-span-7">
			<HandoverPack {...pack} />
		</div>
		<ul class="space-y-6 lg:col-span-5">
			{points.map((point) => (
				<li>
					<p class="display text-2xl">{point.title}</p>
					<div class="mt-1 text-ink-2">
						<RichText value={point.body} />
					</div>
				</li>
			))}
		</ul>
	</div>
</section>
