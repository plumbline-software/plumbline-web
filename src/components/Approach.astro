---
import SectionHeading from './SectionHeading.astro';
import { stages } from '../data';

interface Props {
	as?: 'h1' | 'h2';
}

const { as = 'h2' } = Astro.props;
---

<section id="approach" aria-labelledby="approach-heading" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
	<SectionHeading
		as={as}
		id="approach-heading"
		heading="How we work"
		copy="The same four-stage process on every engagement — not reinvented each time, and not skipped under deadline pressure."
	/>
	<ol class="mt-6">
		{
			stages.map((stage, i) => (
				<li class="grid gap-6 border-b border-rule py-10 lg:grid-cols-12 lg:gap-10">
					<h3 class="display flex items-baseline gap-4 text-5xl lg:col-span-4">
						<span class="w-6 text-2xl text-muted">{i + 1}</span>
						{stage.title}
					</h3>
					<div class="lg:col-span-5">
						<p class="text-lg leading-relaxed text-ink-2">{stage.copy}</p>
						<dl class="mt-6 grid gap-4 text-sm sm:grid-cols-2">
							<div>
								<dt class="label text-muted">You</dt>
								<dd class="mt-1.5 leading-relaxed text-ink-2">{stage.you}</dd>
							</div>
							<div>
								<dt class="label text-muted">Northline</dt>
								<dd class="mt-1.5 leading-relaxed text-ink-2">{stage.us}</dd>
							</div>
						</dl>
					</div>
					<div class="lg:col-span-3">
						<p class="label text-muted">You get</p>
						<p class="mt-1.5 text-lg font-semibold leading-snug text-ink">{stage.outcome}</p>
					</div>
				</li>
			))
		}
	</ol>
</section>
