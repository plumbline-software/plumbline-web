---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
	heading: string;
	lead: string;
	body: string;
	roles: { icon: string; label: string }[];
}

const { heading, lead, body, roles } = Astro.props;
---

<section aria-labelledby="founder-intro-heading" class="bg-paper-2">
	<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
		<SectionHeading id="founder-intro-heading" {heading} />
		<div class="mt-10 grid gap-8 lg:grid-cols-12 lg:gap-10">
			<p class="text-xl font-medium leading-relaxed text-ink lg:col-span-7">{lead}</p>
			<div class="lg:col-span-5">
				<p class="leading-relaxed text-ink-2">{body}</p>
				<div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
					<a href="/how-this-site-was-built" class="link">
						See how this site was built
					</a>
					<a href="/about#founder" class="link">
						Why Plumbline exists
					</a>
				</div>
			</div>
		</div>
		<ul class="mt-12 grid grid-cols-2 border-l border-t border-ink md:grid-cols-4">
			{roles.map((r) => (
				<li class="flex items-center gap-3 border-b border-r border-ink bg-paper px-5 py-5 font-medium text-ink">
					<Icon name={r.icon} class="size-6 shrink-0" />
					{r.label}
				</li>
			))}
		</ul>
	</div>
</section>
