---
import { buttonVariants } from '@/components/ui/button';
import { SITE, FOUNDER } from '../data';
---

<section aria-labelledby="hero-heading">
	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<!-- The plumb line: hangs from the header mark (same x as its string) and ends in the bob. -->
		<div class="plumb pointer-events-none absolute inset-y-0 left-[calc(1rem+4px)] w-px sm:left-[calc(1.5rem+4px)] lg:left-[calc(2rem+4px)]" aria-hidden="true">
			<span class="plumb-string absolute inset-x-0 bottom-9 top-0 bg-ink"></span>
			<svg viewBox="0 0 8 14" class="absolute bottom-3 left-1/2 h-6 w-[0.5625rem] -translate-x-1/2 text-ink" fill="currentColor"><path d="M4 0 7.5 4.5 4 14 .5 4.5z" /></svg>
		</div>
		<div class="grid gap-10 pb-20 pl-[1.3125rem] pt-16 sm:pt-24 lg:grid-cols-12 lg:items-end lg:gap-x-10 lg:pb-28 lg:pt-28">
			<h1 id="hero-heading" class="display text-[clamp(3.5rem,10vw,6rem)] text-ink lg:col-span-7">
				Software that still makes sense in two years.
			</h1>
			<div class="lg:col-span-5">
				<p class="text-lg leading-relaxed text-ink">Software development &amp; technology consulting in {SITE.location}.</p>
				<p class="mt-3 text-lg leading-relaxed text-ink-2">
					Web applications, internal tools, APIs and cloud infrastructure, built so your own team can still read,
					extend and trust them long after the project ends.
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a href="/contact" class={buttonVariants()}>Start a conversation</a>
					<a href="/services" class={buttonVariants({ variant: 'outline' })}>See what we build</a>
				</div>
				<p class="mt-8 border-t border-rule pt-5 leading-relaxed text-ink-2">
					Founder-led: you work directly with <a href="/about#founder" class="link text-ink">the founder</a>{`, ${FOUNDER.background}. Every inquiry gets a personal reply within ${SITE.replyTime}.`}
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	/* The one authored load moment: the string drops from the header mark. */
	.plumb-string {
		transform-origin: top;
		animation: drop 0.9s 0.15s cubic-bezier(0.16, 1, 0.3, 1) both;
	}
	.plumb svg {
		animation: settle 0.5s 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
	}
	@keyframes drop {
		from {
			transform: scaleY(0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.plumb-string,
		.plumb svg {
			animation: none;
		}
	}
	@keyframes settle {
		from {
			opacity: 0;
			transform: translate(-50%, -8px);
		}
	}
</style>
