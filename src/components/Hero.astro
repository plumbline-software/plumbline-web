---
import { SITE, FOUNDER } from '../data';
---

<section aria-labelledby="hero-heading">
	<div class="mx-auto grid max-w-7xl gap-10 px-4 pb-16 pt-16 sm:px-6 sm:pt-24 lg:grid-cols-12 lg:items-end lg:gap-x-10 lg:px-8 lg:pb-24 lg:pt-28">
		<h1 id="hero-heading" class="display text-[clamp(3.5rem,10vw,6rem)] text-ink lg:col-span-7">
			Software that still makes sense in two years.
		</h1>
		<div class="lg:col-span-5">
			<p class="text-lg leading-relaxed text-ink-2">
				Software development &amp; technology consulting in {SITE.location}. Northline Technologies designs
				and builds web applications, internal tools, APIs, and cloud infrastructure — software your own team
				can still read, extend, and trust long after we've moved on to the next thing.
			</p>
			<div class="mt-8 flex flex-col gap-3 sm:flex-row">
				<a href="/contact" class="btn btn-ink">Start a conversation</a>
				<a href="/services" class="btn btn-line">See what we build</a>
			</div>
			<p class="mt-8 border-t border-rule pt-5 text-sm leading-relaxed text-muted">
				Founded by <a href="/about#founder" class="link text-ink">{FOUNDER.name}</a>{`, previously ${FOUNDER.previously}. Every inquiry gets a personal reply within ${SITE.replyTime}.`}
			</p>
		</div>
	</div>
</section>
