---
interface Props {
	slug: string;
	name: string;
	description: string;
	detail?: string;
	bullets?: string[];
}

const { slug, name, description, detail, bullets } = Astro.props;
---

<article id={slug} class="grid scroll-mt-24 gap-5 border-b border-rule py-10 lg:grid-cols-12 lg:gap-10">
	<h3 class="display text-4xl sm:text-5xl lg:col-span-4">{name}</h3>
	<div class="lg:col-span-5">
		<p class="text-lg font-semibold leading-snug text-ink">{description}</p>
		{detail && <p class="mt-3 leading-relaxed text-ink-2">{detail}</p>}
	</div>
	<div class="lg:col-span-3">
		{
			bullets && bullets.length > 0 && (
				<ul class="space-y-2.5 text-sm text-ink-2">
					{bullets.map((item) => (
						<li class="flex items-start gap-3">
							<svg viewBox="0 0 16 16" class="mt-0.5 h-4 w-4 shrink-0 text-ink" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m3 8.5 3 3 7-7" /></svg>
							{item}
						</li>
					))}
				</ul>
			)
		}
		<a href={`/contact?service=${slug}`} class="link mt-5 inline-block text-sm">Discuss a project like this</a>
	</div>
</article>
