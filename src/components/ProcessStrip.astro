---
import SectionHeading from './SectionHeading.astro';
import { stages } from '../data';
---

<section aria-labelledby="process-heading" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
	<SectionHeading
		id="process-heading"
		heading="How an engagement runs"
		copy="The same four stages every time, with one engineer from the first question to the handover."
	/>
	<ol class="mt-12 grid gap-x-10 md:grid-cols-2 lg:grid-cols-4">
		{
			stages.map((stage, i) => (
				<li class="border-t border-ink pb-8 pt-5">
					<h3 class="display flex items-baseline gap-3 text-3xl">
						<span class="text-xl text-muted-foreground" aria-hidden="true">{i + 1}</span>
						{stage.title}
					</h3>
					<p class="mt-3 text-sm text-muted-foreground">You get</p>
					<p class="mt-1 font-medium leading-snug text-ink">{stage.outcome}</p>
				</li>
			))
		}
	</ol>
	<a href="/approach" class="link mt-8 inline-block">See how each stage works</a>
</section>
