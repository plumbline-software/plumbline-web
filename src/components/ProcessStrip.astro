---
import SectionHeading from './SectionHeading.astro';
import { stages } from '../data';
---

<section aria-labelledby="process-heading" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
	<SectionHeading
		id="process-heading"
		heading="How an engagement runs"
		copy="The same four stages every time, with one engineer from the first question to the handover."
	/>
	<ol class="relative mt-14 grid gap-x-10 gap-y-2 md:grid-cols-2 lg:grid-cols-4">
		<span class="absolute inset-x-0 top-4 hidden h-px bg-ink lg:block" aria-hidden="true"></span>
		{stages.map((stage, i) => (
			<li class="relative pb-8">
				<span
					class="relative flex h-8 w-8 items-center justify-center border border-ink bg-paper font-display text-base font-semibold"
					aria-hidden="true"
				>
					{i + 1}
				</span>
				<h3 class="display mt-5 text-3xl">{stage.title}</h3>
				<p class="mt-3 text-sm text-muted-foreground">You get</p>
				<p class="mt-1 font-medium leading-snug text-ink">{stage.outcome}</p>
			</li>
		))}
	</ol>
	<a href="/approach" class="link mt-8 inline-block">
		See how each stage works
	</a>
</section>
