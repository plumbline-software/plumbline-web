---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

// Claims a buyer can check. Keep them true: this site is the sample.
interface Props {
	heading: string;
	copy: string;
	items: { icon: string; title: string; copy: string; linkLabel?: string; href?: string }[];
}

const { heading, copy, items } = Astro.props;
---

<section aria-labelledby="enterprise-heading">
	<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
		<SectionHeading id="enterprise-heading" {heading} {copy} />
		<dl class="mt-12 grid gap-x-10 md:grid-cols-2">
			{items.map((item) => (
				<div class="border-t border-ink pb-8 pt-5">
					<dt class="display flex items-center gap-3 text-3xl">
						<Icon name={item.icon} class="size-7 shrink-0" />
						{item.title}
					</dt>
					<dd class="mt-3 max-w-xl leading-relaxed text-ink-2">{item.copy}</dd>
					{item.href && (
						<dd class="mt-3">
							<a href={item.href} class="link text-sm">
								{item.linkLabel ?? item.title}
							</a>
						</dd>
					)}
				</div>
			))}
		</dl>
	</div>
</section>
