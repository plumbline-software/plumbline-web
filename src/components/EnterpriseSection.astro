---
import SectionHeading from './SectionHeading.astro';

const capabilities = [
	'Security-conscious development',
	'API integration',
	'Cloud infrastructure',
	'CI/CD',
	'Testing',
	'Documentation',
	'Maintainability',
	'Accessibility',
];
---

<section aria-labelledby="enterprise-heading">
	<div class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 sm:pb-28 lg:px-8">
		<SectionHeading
			id="enterprise-heading"
			heading="Ready for complex environments."
			copy="Enterprise and public-sector projects come with real constraints — procurement processes, accessibility requirements, security review, legacy systems that can't simply be replaced overnight. We build with those constraints in mind from the start, not as a compliance pass before launch."
		/>
		<ul class="mt-12 grid gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
			{
				capabilities.map((item) => (
					<li class="flex items-start gap-3 border-t border-rule pt-4 font-medium text-ink">
						<svg viewBox="0 0 16 16" class="mt-1 h-4 w-4 shrink-0 text-ink" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m3 8.5 3 3 7-7" /></svg>
						{item}
					</li>
				))
			}
		</ul>
	</div>
</section>
