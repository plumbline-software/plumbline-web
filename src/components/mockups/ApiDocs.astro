---
import MockFrame from './MockFrame.astro';
interface Props {
	caption?: string;
	class?: string;
}
const { caption = 'API documentation another team can integrate with, without a meeting.', class: className } =
	Astro.props;
---

<MockFrame
	height={430}
	label="Illustrative screenshot of API documentation showing an endpoint with an example request and response"
	url="docs.example.com/api/v2"
	caption={caption}
	class={className}
>
	<div class="flex h-full text-[13px]">
		<aside class="w-52 shrink-0 border-r border-ink p-4">
			<p class="label text-muted-foreground">API v2</p>
			<ul class="mt-3 space-y-1">
				<li class="px-2 py-1.5">Authentication</li>
				<li class="px-2 py-1.5">Errors</li>
				<li class="bg-ink px-2 py-1.5 text-paper">Create a booking</li>
				<li class="px-2 py-1.5">List bookings</li>
				<li class="px-2 py-1.5">Cancel a booking</li>
				<li class="px-2 py-1.5">Webhooks</li>
			</ul>
		</aside>
		<main class="flex-1 p-6">
			<p class="display text-3xl">Create a booking</p>
			<p class="mt-2 font-mono text-[12px]">
				<span class="bg-ink px-1.5 py-0.5 text-paper">POST</span> /v2/bookings
			</p>
			<p class="mt-3 max-w-md text-ink-2">
				Creates a booking for a customer. Idempotent: send the same{' '}
				<span class="font-mono text-[12px]">Idempotency-Key</span> twice and only one booking is made.
			</p>
			<div class="mt-4 grid grid-cols-2 gap-4">
				<div class="border border-ink">
					<p class="border-b border-ink px-3 py-1.5 text-[11px] text-muted-foreground">Request</p>
					<pre class="m-0 p-3 font-mono text-[11px] leading-relaxed">{`{
  "customer_id": "cus_8421",
  "starts_at": "2026-11-14T10:00",
  "service": "fitting",
  "notes": "First visit"
}`}</pre>
				</div>
				<div class="border border-ink">
					<p class="border-b border-ink px-3 py-1.5 text-[11px] text-muted-foreground">Response · 201 Created</p>
					<pre class="m-0 p-3 font-mono text-[11px] leading-relaxed">{`{
  "id": "bkg_20931",
  "status": "confirmed",
  "starts_at": "2026-11-14T10:00",
  "created_at": "2026-11-02T16:41"
}`}</pre>
				</div>
			</div>
			<p class="mt-4 text-[12px] text-ink-2">
				Errors: <span class="font-mono">409</span> slot taken, <span class="font-mono">422</span> invalid time. Every
				error has a stable code.
			</p>
		</main>
	</div>
</MockFrame>
