---
// A product "screenshot" drawn in HTML and scaled like an image: content is laid out at a fixed
// design size inside an SVG foreignObject, so it shrinks cleanly on phones instead of reflowing.
// Always captioned as an illustrative example — these are not client projects.
interface Props {
	label: string;
	width?: number;
	height?: number;
	url?: string;
	caption?: string;
	class?: string;
}

const { label, width = 960, height = 600, url = 'app.example.com', caption, class: className = '' } = Astro.props;
---

<figure class:list={['m-0', className]}>
	<svg
		viewBox={`0 0 ${width} ${height}`}
		class="block h-auto w-full border border-ink bg-paper"
		role="img"
		aria-label={label}
	>
		<foreignObject x="0" y="0" width={width} height={height}>
			<div
				aria-hidden="true"
				class="flex h-full w-full flex-col bg-paper font-sans text-ink"
				style={`width:${width}px;height:${height}px`}
			>
				<div class="flex h-10 shrink-0 items-center gap-4 border-b border-ink px-4">
					<span class="flex gap-1.5">
						<i class="block size-2.5 border border-ink"></i>
						<i class="block size-2.5 border border-ink"></i>
						<i class="block size-2.5 border border-ink"></i>
					</span>
					<span class="flex-1 border border-rule bg-paper-2 px-3 py-1 text-[11px] text-muted-foreground">{url}</span>
				</div>
				<div class="min-h-0 flex-1 overflow-hidden">
					<slot />
				</div>
			</div>
		</foreignObject>
	</svg>
	<figcaption class="mt-3 flex items-baseline justify-between gap-4 text-sm text-ink-2">
		<span>{caption}</span>
		<span class="label shrink-0 text-muted-foreground">Illustrative example</span>
	</figcaption>
</figure>
