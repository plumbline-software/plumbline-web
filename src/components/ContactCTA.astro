---
import { SITE, FOUNDER } from '../data';

interface Props {
	heading?: string;
	copy?: string;
}

const {
	heading = 'Have a project in mind?',
	copy = "Tell us what you're trying to build, improve, or solve.",
} = Astro.props;

---

<section aria-labelledby="cta-heading" class="bg-ink text-paper">
	<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
		<h2 id="cta-heading" class="display max-w-3xl text-[clamp(3rem,8vw,5.5rem)]">{heading}</h2>
		<p class="mt-6 max-w-xl text-lg leading-relaxed text-paper/80">
			{copy} You'll hear back from {FOUNDER.firstName} within {SITE.replyTime}.
		</p>
		<div class="mt-10 flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-8">
			<a href="/contact" class="btn btn-paper">Get in touch</a>
			<a href={`mailto:${SITE.email}`} class="text-sm text-paper/80 underline decoration-paper/40 hover:text-paper hover:decoration-paper">
				{SITE.email}
			</a>
		</div>
	</div>
</section>
