---
import SectionHeading from './SectionHeading.astro';
import PrincipleCard from './PrincipleCard.astro';

interface Props {
	heading: string;
	copy: string;
	items: { icon?: string; title: string; copy: string; detail?: string }[];
}

const { heading, copy, items } = Astro.props;
---

<section aria-labelledby="principles-heading" class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 sm:pb-24 lg:px-8">
	<SectionHeading id="principles-heading" {heading} {copy} />
	<div class="mt-4">
		{items.map((principle) => (
			<PrincipleCard {...principle} />
		))}
	</div>
</section>
