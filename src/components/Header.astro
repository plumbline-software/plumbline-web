---
import MobileNav from './MobileNav.astro';
import StaffGlyph from './StaffGlyph.astro';

const links = [
	{ href: '/services', label: 'Services' },
	{ href: '/approach', label: 'Approach' },
	{ href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-ink bg-paper/95 backdrop-blur-sm">
	<div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
		<a href="/" class="flex items-center gap-3 text-ink">
			<StaffGlyph class="h-8 w-auto" />
			<span class="label text-[0.75rem] tracking-[0.2em]">Northline Technologies</span>
		</a>

		<nav class="hidden md:block" aria-label="Primary">
			<ul class="flex items-center gap-9">
				{
					links.map((link) => {
						const isActive = currentPath.startsWith(link.href);
						return (
							<li>
								<a
									href={link.href}
									aria-current={isActive ? 'page' : undefined}
									class:list={['py-2 text-sm font-medium transition-colors', isActive ? 'text-ink underline decoration-2 underline-offset-[0.6em]' : 'text-muted hover:text-ink']}
								>
									{link.label}
								</a>
							</li>
						);
					})
				}
			</ul>
		</nav>

		<div class="flex items-center gap-3">
			<a href="/contact" class="btn btn-line hidden min-h-10 sm:inline-flex">Start a project</a>
			<MobileNav />
		</div>
	</div>
</header>
