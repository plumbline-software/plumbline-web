---
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { settings as SITE } from '@/lib/sanity';
import MobileNav from './MobileNav.astro';
import Mark from './Mark.astro';

const links = [
	{ href: '/services', label: 'Services' },
	{ href: '/approach', label: 'Approach' },
	{ href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-ink bg-paper/95 backdrop-blur-sm">
	<div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:gap-6 sm:px-6 lg:px-8">
		<a href="/" class="flex items-center gap-3 text-ink">
			<Mark class="h-8 w-auto" />
			<span class="label text-[0.75rem] tracking-[0.2em]">
				{SITE.shortName}
				<span class="hidden min-[420px]:inline">{SITE.name.slice(SITE.shortName.length)}</span>
			</span>
		</a>

		<nav class="hidden md:block" aria-label="Primary">
			<ul class="flex items-center gap-9">
				{links.map((link) => {
					const isActive = currentPath.startsWith(link.href);
					return (
						<li>
							<a
								href={link.href}
								aria-current={isActive ? 'page' : undefined}
								class:list={[
									'py-2 text-sm font-medium transition-colors',
									isActive
										? 'text-ink underline decoration-2 underline-offset-[0.6em]'
										: 'text-muted-foreground hover:text-ink',
								]}
							>
								{link.label}
							</a>
						</li>
					);
				})}
			</ul>
		</nav>

		<div class="flex items-center gap-2 sm:gap-3">
			{currentPath !== '/contact' && (
				<a
					href="/contact"
					class={cn(
						buttonVariants({ variant: 'outline', size: 'sm' }),
						'hidden min-[370px]:inline-flex text-sm sm:text-[0.9375rem]',
					)}
				>
					Start a conversation
				</a>
			)}
			<MobileNav />
		</div>
	</div>
</header>
