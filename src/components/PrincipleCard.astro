---
interface Props {
	title: string;
	copy: string;
	detail?: string;
}

const { title, copy, detail } = Astro.props;
---

<div class="grid gap-3 border-b border-rule py-8 lg:grid-cols-12 lg:gap-10">
	<h3 class="display text-4xl lg:col-span-4">{title}</h3>
	<div class="lg:col-span-8">
		<p class="text-xl font-semibold leading-snug text-ink">{copy}</p>
		{detail && <p class="mt-2 max-w-2xl leading-relaxed text-ink-2">{detail}</p>}
	</div>
</div>
