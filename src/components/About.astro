---
import Flow from './Flow.astro';
import RichText from './RichText.astro';

interface Props {
	heading: string;
	intro: any[];
	flow: { steps: any[]; caption?: string };
}

const { heading, intro, flow } = Astro.props;
---

<section id="about" aria-labelledby="about-heading" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
	<div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
		<h1 id="about-heading" class="display text-[clamp(3.25rem,9vw,5.75rem)] lg:col-span-7">
			{heading}
		</h1>
		<div class="space-y-5 text-lg leading-relaxed text-ink-2 lg:col-span-5 lg:self-end [&_strong]:font-semibold [&_strong]:text-ink">
			<RichText value={intro} />
		</div>
	</div>
	<Flow class="mt-14" {...flow} />
</section>
