---
import SectionHeading from './SectionHeading.astro';
import ServiceCard from './ServiceCard.astro';
import { services } from '@/lib/sanity';
import Flow from './Flow.astro';

interface Props {
	as?: 'h1' | 'h2';
	heading: string;
	copy: string;
	flow?: { steps: any[]; caption?: string };
}

const { as = 'h2', heading, copy, flow } = Astro.props;
---

<section id="services" aria-labelledby="services-heading" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
	<SectionHeading as={as} id="services-heading" {heading} {copy} />
	{as === 'h1' && flow && <Flow class="mt-12" {...flow} />}
	<div class="mt-2">
		{services.map((service) => (
			<ServiceCard {...service} />
		))}
	</div>
</section>
