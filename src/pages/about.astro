---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data';
import Header from '../components/Header.astro';
import About from '../components/About.astro';
import Founder from '../components/Founder.astro';
import Principles from '../components/Principles.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title={`Founder-Led Software Engineering in Vancouver | ${SITE.shortName}`}
	description={`${SITE.name} is a founder-led software consultancy in Vancouver, BC. Work directly with the engineer who scopes and builds your software.`}
>
	<Header />
	<main>
		<About />
		<Founder />
		<Principles />
		<ContactCTA heading="Talk to the engineer directly." copy="Tell us what you're trying to build, improve, or solve." />
	</main>
	<Footer />
</Layout>
