---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import About from '../components/About.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Founder from '../components/Founder.astro';
import Principles from '../components/Principles.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import { getPage } from '@/lib/sanity';

const page = await getPage('aboutPage');
---

<Layout seo={page.seo}>
	<Header />
	<main>
		<About heading={page.heading} intro={page.intro} flow={page.flow} />
		<PhotoBand photo={page.photo} />
		<Founder {...page.founder} />
		<Principles {...page.principles} />
		<ContactCTA {...page.cta} />
	</main>
	<Footer />
</Layout>
