---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Positioning from '../components/Positioning.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EnterpriseSection from '../components/EnterpriseSection.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import { services } from '../data';
---

<Layout>
	<Header />
	<main>
		<Hero />
		<Positioning />
		<section aria-labelledby="services-index-heading" class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 sm:pb-28 lg:px-8">
			<SectionHeading
				id="services-index-heading"
				heading="What we build"
				copy="Most projects touch more than one of these at once."
			/>
			<ul class="mt-10 border-b border-rule">
				{
					services.map((service) => (
						<li class="border-t border-rule first:border-t-0">
							<a href={`/services#${service.slug}`} class="group grid items-center gap-1 py-6 sm:grid-cols-[5fr_6fr_1.5rem] sm:gap-x-8">
								<span class="display text-3xl sm:text-4xl group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">{service.name}</span>
								<span class="text-ink-2">{service.summary}</span>
								<svg viewBox="0 0 24 24" class="hidden h-5 w-5 transition-transform duration-200 group-hover:translate-x-1 sm:block" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M5 12h14M13 6l6 6-6 6" />
								</svg>
							</a>
						</li>
					))
				}
			</ul>
		</section>
		<EnterpriseSection />
		<ContactCTA />
	</main>
	<Footer />
</Layout>
