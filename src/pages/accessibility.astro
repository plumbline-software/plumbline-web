---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SectionHeading from '../components/SectionHeading.astro';
import DocSection from '../components/DocSection.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data';

const updated = 'October 12, 2026';
---

<Layout title={`Accessibility | ${SITE.name}`} description={`The accessibility standard ${SITE.name}'s website is built to, how it was checked, and how to report a problem.`}>
	<Header />
	<main class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
		<SectionHeading
			as="h1"
			id="accessibility-heading"
			heading="Accessibility"
			copy={`This site aims to meet the Web Content Accessibility Guidelines (WCAG) 2.2 at Level AA. Last reviewed ${updated}.`}
		/>

		<DocSection heading="What's in place">
			<ul>
				<li>Every page uses headings in order, so screen readers can navigate by section.</li>
				<li>Every form field has a label; errors are announced and linked to the field they describe.</li>
				<li>Everything works with a keyboard, with a visible focus outline.</li>
				<li>Text and controls meet WCAG AA colour contrast. Colour is never the only way information is shown.</li>
				<li>Animation is switched off when your device asks for reduced motion.</li>
			</ul>
		</DocSection>

		<DocSection heading="How it was checked">
			<p>
				Automated checks (Lighthouse accessibility score of 100 and a design-quality scanner) plus manual
				keyboard testing of the navigation and the contact form. A full audit with screen-reader users has not
				been done yet.
			</p>
		</DocSection>

		<DocSection heading="Report a problem">
			<p>
				If anything on this site is hard to use, email <a href={`mailto:${SITE.email}`} class="link">{SITE.email}</a>.
				You'll get a reply within {SITE.replyTime}, and the issue will be fixed or a workaround offered.
			</p>
		</DocSection>
	</main>
	<Footer />
</Layout>
