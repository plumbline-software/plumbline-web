---
import '../styles/global.css';
import { SITE, services } from '../data';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = `Vancouver Software Development & Consulting | ${SITE.name}`,
	description = 'Founder-led software development in Vancouver, BC for small businesses and startups: web apps, internal tools and APIs built to last.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// Search-engine ownership checks: paste the codes from Google Search Console and Bing Webmaster Tools
// into these environment variables (Vercel → Settings → Environment Variables), then redeploy.
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
// Vercel Web Analytics: cookieless page views, enabled only on Vercel builds.
const vercelAnalytics = Boolean(import.meta.env.VERCEL);

// Describes the business, its services and the website to search engines.
// The founder is deliberately not named here.
const businessId = new URL('/#business', Astro.site).href;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfessionalService',
			'@id': businessId,
			name: SITE.name,
			description: 'Founder-led software development and technology consulting in Vancouver, BC.',
			url: Astro.site?.href,
			logo: new URL('/apple-touch-icon.png', Astro.site).href,
			image: ogImage.href,
			email: SITE.email,
			address: { '@type': 'PostalAddress', addressLocality: 'Vancouver', addressRegion: 'BC', addressCountry: 'CA' },
			areaServed: 'Canada',
			knowsAbout: ['Web application development', 'Frontend engineering', 'API development', 'Technology consulting'],
			hasOfferCatalog: {
				'@type': 'OfferCatalog',
				name: 'Software development services',
				itemListElement: services.map((s) => ({
					'@type': 'Offer',
					itemOffered: {
						'@type': 'Service',
						name: s.name,
						description: s.summary,
						url: new URL(`/services#${s.slug}`, Astro.site).href,
						provider: { '@id': businessId },
					},
				})),
			},
		},
		{
			'@type': 'WebSite',
			name: SITE.name,
			url: Astro.site?.href,
			inLanguage: 'en-CA',
			publisher: { '@id': businessId },
		},
	],
};
---

<!doctype html>
<html lang="en-CA">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#10141a" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content="en_CA" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${SITE.name}: Software that still makes sense in two years.`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
		{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		{vercelAnalytics && (
			<Fragment>
				<script is:inline>
					window.va =
						window.va ||
						function () {
							(window.vaq = window.vaq || []).push(arguments);
						};
				</script>
				<script is:inline defer src="/_vercel/insights/script.js"></script>
			</Fragment>
		)}
	</head>
	<body class="bg-paper font-sans text-ink">
		<slot />
	</body>
</html>
